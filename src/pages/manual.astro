---
const title = "Manual de HogarGo | Guía visual con infografías";
const description =
  "Manual de usuario de HogarGo con infografías: tareas y puntos, planificador, gastos compartidos, finanzas personales, lista de la compra y HogarPlus. Descárgalo en PDF.";
const pdf = "/manual/HogarGo-Manual.pdf";
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
---

<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#1f2e47" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/png" href="/logoandroid.png" />
<meta property="og:type" content="article" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={abs("/manual/img/01_inicio.jpg")} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>

<header class="barra-web">
  <a class="marca" href="/" aria-label="HogarGo, inicio"><img src="/logoandroid.png" alt="" width="32" height="32" />HogarGo</a>
  <nav class="enlaces" aria-label="Principal">
    <a href="/">Inicio</a>
    <a href="/#tutoriales">Tutoriales</a>
  </nav>
  <a class="btn-pdf" href={pdf} download>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0l-5-5m5 5l5-5M5 21h14"/></svg>
    Descargar PDF
  </a>
</header>

<main class="paginas">

<!-- ================= 1. PORTADA ================= -->
<section class="pagina portada">
  <img class="logo" src="/manual/img/logo.webp" alt="Logo de HogarGo">
  <div class="tipo">Manual de usuario</div>
  <h1>HogarGo</h1>
  <p class="lema" style="color:#fff">Tu casa, organizada entre todos: tareas, compra y gastos en una sola app.</p>
  <span class="version">Versión 1.3 · Android</span>

  <div class="pilares">
    <div class="pilar"><div class="e">✅</div><strong>Tareas</strong><span>Reparte, planifica y suma puntos</span></div>
    <div class="pilar"><div class="e">💶</div><strong>Gastos</strong><span>Quién paga y quién debe a quién</span></div>
    <div class="pilar"><div class="e">💼</div><strong>Finanzas</strong><span>Tu cuenta, presupuestos y ahorro</span></div>
    <div class="pilar"><div class="e">🛒</div><strong>Compra</strong><span>Listas compartidas al momento</span></div>
  </div>

  <img class="movil-portada" src="/manual/img/01_inicio.jpg" alt="Pantalla de inicio de HogarGo">
  <div class="pie"><span>HogarGo · MbN</span><span>hogargoapp@gmail.com</span></div>
</section>

<!-- ================= 2. ÍNDICE + MAPA ================= -->
<section class="pagina">
  <div class="cab"><div class="num">i</div><div><h2>Contenido</h2><div class="sub">Todo lo que puedes hacer con HogarGo</div></div></div>

  <nav class="indice">
    <a href="#primeros-pasos"><span class="i">1</span><div><strong>Primeros pasos</strong><span>Cuenta, hogar e invitaciones</span></div><b class="pg">3</b></a>
    <a href="#inicio"><span class="i">2</span><div><strong>La pantalla de Inicio</strong><span>Ranking y resumen del hogar</span></div><b class="pg">4</b></a>
    <a href="#tareas" style="--c:var(--lila)"><span class="i">3</span><div><strong>Tareas y puntos</strong><span>Crear, asignar y marcar</span></div><b class="pg">5</b></a>
    <a href="#planificador" style="--c:var(--lila)"><span class="i">4</span><div><strong>Planificador e historial</strong><span>Programar y revisar</span></div><b class="pg">6</b></a>
    <a href="#gastos" style="--c:var(--verde)"><span class="i">5</span><div><strong>Gastos compartidos</strong><span>Movimientos, saldos y liquidar</span></div><b class="pg">7</b></a>
    <a href="#finanzas" style="--c:var(--verde)"><span class="i">6</span><div><strong>Finanzas personales</strong><span>Mi cuenta y presupuestos</span></div><b class="pg">8</b></a>
    <a href="#compra" style="--c:var(--naranja)"><span class="i">7</span><div><strong>Lista de la compra</strong><span>Listas y productos</span></div><b class="pg">9</b></a>
    <a href="#configuracion" style="--c:var(--texto-2)"><span class="i">8</span><div><strong>Configuración</strong><span>Hogares, usuarios y ajustes</span></div><b class="pg">10</b></a>
    <a href="#hogarplus" style="--c:var(--bronce-osc)"><span class="i">9</span><div><strong>HogarPlus</strong><span>Gratis frente a Plus</span></div><b class="pg">11</b></a>
    <a href="#ayuda" style="--c:var(--marca-osc)"><span class="i">?</span><div><strong>Preguntas frecuentes</strong><span>Dudas habituales y contacto</span></div><b class="pg">12</b></a>
  </nav>

  <h3 style="font-size:13pt;margin:8mm 0 2mm">Mapa de la app</h3>
  <p>La barra inferior te lleva a las cuatro secciones. El botón central <strong>+</strong> cambia según dónde estés: crea lo propio de cada pantalla. Configuración está en el engranaje de la cabecera.</p>

  <!-- Infografía: barra de navegación -->
  <svg viewBox="0 0 640 250" width="100%" role="img" aria-label="Mapa de navegación de HogarGo">
    <defs>
      <linearGradient id="gBarra" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f5f8fd"/><stop offset="1" stop-color="#e2e9f5"/></linearGradient>
      <linearGradient id="gFab" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6a89bd"/><stop offset="1" stop-color="#3a557f"/></linearGradient>
    </defs>
    <!-- etiquetas superiores -->
    <g font-family="Plus Jakarta Sans, sans-serif" font-size="12" fill="#4a5468" text-anchor="middle">
      <rect x="20" y="8" width="120" height="58" rx="12" fill="#e8edf6"/>
      <text x="80" y="31" font-weight="700" fill="#1f2e47">Hogar</text><text x="80" y="48">Ranking y resumen</text>
      <rect x="148" y="8" width="120" height="58" rx="12" fill="#ecebfa"/>
      <text x="208" y="31" font-weight="700" fill="#1f2e47">Tareas</text><text x="208" y="48">Gestión, planificador</text><text x="208" y="61" font-size="11">e historial</text>
      <rect x="372" y="8" width="120" height="58" rx="12" fill="#e0f3ec"/>
      <text x="432" y="31" font-weight="700" fill="#1f2e47">Economía</text><text x="432" y="48">Movimientos</text><text x="432" y="61" font-size="11">y Personal</text>
      <rect x="500" y="8" width="120" height="58" rx="12" fill="#fbe9e1"/>
      <text x="560" y="31" font-weight="700" fill="#1f2e47">Compra</text><text x="560" y="48">Listas de la compra</text>
      <rect x="260" y="196" width="120" height="48" rx="12" fill="#f3ece3"/>
      <text x="320" y="216" font-weight="700" fill="#6f5638">Botón +</text><text x="320" y="233" fill="#6f5638">Acción rápida</text>
    </g>
    <g stroke="#9aa8bf" stroke-width="1.5" stroke-dasharray="4 4">
      <line x1="80" y1="66" x2="80" y2="112"/><line x1="208" y1="66" x2="208" y2="112"/>
      <line x1="432" y1="66" x2="432" y2="112"/><line x1="560" y1="66" x2="560" y2="112"/>
      <line x1="320" y1="176" x2="320" y2="196"/>
    </g>
    <!-- barra -->
    <rect x="20" y="112" width="600" height="72" rx="36" fill="url(#gBarra)" stroke="#d3dde9"/>
    <g font-family="Plus Jakarta Sans, sans-serif" font-size="12" text-anchor="middle">
      <rect x="56" y="124" width="48" height="28" rx="14" fill="#d8e2f1"/>
      <path d="M70 146v-10l10-8 10 8v10h-7v-6h-6v6z" fill="#4f6fa3"/>
      <text x="80" y="172" font-weight="700" fill="#4f6fa3">Hogar</text>
      <rect x="199" y="127" width="18" height="22" rx="3" fill="none" stroke="#8a94a6" stroke-width="2.4"/>
      <line x1="203" y1="135" x2="213" y2="135" stroke="#8a94a6" stroke-width="2"/><line x1="203" y1="141" x2="213" y2="141" stroke="#8a94a6" stroke-width="2"/>
      <text x="208" y="172" fill="#6b7383">Tareas</text>
      <text x="432" y="150" font-size="22" font-weight="700" fill="#8a94a6">$</text>
      <text x="432" y="172" fill="#6b7383">Economía</text>
      <path d="M548 130h4l3 13h12l3-9h-16" fill="none" stroke="#8a94a6" stroke-width="2.4" stroke-linejoin="round"/>
      <circle cx="557" cy="148" r="2" fill="#8a94a6"/><circle cx="566" cy="148" r="2" fill="#8a94a6"/>
      <text x="560" y="172" fill="#6b7383">Compra</text>
    </g>
    <circle cx="320" cy="140" r="30" fill="url(#gFab)" stroke="#fff" stroke-width="3"/>
    <path d="M320 127v26M307 140h26" stroke="#fff" stroke-width="3.5" stroke-linecap="round"/>
    <!-- engranaje -->
    <g transform="translate(560 214)">
      <rect x="-60" y="-18" width="120" height="36" rx="12" fill="#eef3fa" stroke="#d3dde9"/>
      <circle cx="-40" cy="0" r="7" fill="none" stroke="#4f6fa3" stroke-width="3" stroke-dasharray="3 2.5"/>
      <circle cx="-40" cy="0" r="2.5" fill="#4f6fa3"/>
      <text x="8" y="4" font-family="Plus Jakarta Sans, sans-serif" font-size="12" font-weight="700" fill="#1f2e47" text-anchor="middle">Configuración</text>
    </g>
  </svg>

  <div class="consejo mt-auto"><span class="ico">🎓</span><div>Cada sección tiene su propio <strong>tutorial</strong> la primera vez que entras. Puedes repetirlos cuando quieras en <strong>Configuración → Tutoriales</strong>.</div></div>
  <div class="pie"><span>Manual de HogarGo</span><span>2</span></div>
</section>

<!-- ================= 3. PRIMEROS PASOS ================= -->
<section class="pagina" id="primeros-pasos">
  <div class="cab"><div class="num">1</div><div><h2>Primeros pasos</h2><div class="sub">De la descarga a tu hogar compartido en cuatro pasos</div></div></div>

  <div class="pasos">
    <div class="paso"><div class="circ">📲<span class="n">1</span></div><h4>Crea tu cuenta</h4><p>Con tu email y contraseña o con <strong>Continúa con Google</strong>.</p></div>
    <div class="paso"><div class="circ">🏠<span class="n">2</span></div><h4>Crea tu hogar</h4><p>Ponle nombre. Puedes cambiarlo después en Configuración → Hogares.</p></div>
    <div class="paso"><div class="circ">✉️<span class="n">3</span></div><h4>Invita a los demás</h4><p>Genera un <strong>código de invitación</strong> y compártelo.</p></div>
    <div class="paso"><div class="circ">🎉<span class="n">4</span></div><h4>¡A organizar!</h4><p>Todo se sincroniza al momento en los móviles del hogar.</p></div>
  </div>

  <h3 style="font-size:13pt;margin:9mm 0 3mm">Tres formas de sumar personas</h3>
  <div class="fila">
    <div class="tarjeta col">
      <div style="font-size:20pt">👥</div>
      <h3>Con cuenta sincronizada</h3>
      <p>Cada uno usa HogarGo en su móvil. Desde <strong>Configuración → Hogares → Generar invitación</strong> creas un código; la otra persona entra en <strong>Unirse a un hogar existente</strong>, lo pega y escribe su nombre.</p>
    </div>
    <div class="tarjeta col">
      <div style="font-size:20pt">🧒</div>
      <h3>Usuario sin cuenta</h3>
      <p>Para peques o para quien no quiere instalar la app. En <strong>Configuración → Usuarios → Agregar usuario sin cuenta</strong>. Tú le apuntas las tareas y los gastos.</p>
    </div>
    <div class="tarjeta col">
      <div style="font-size:20pt">🙋</div>
      <h3>Modo «Un usuario»</h3>
      <p>¿Vives solo? Actívalo en <strong>Configuración → Modo del hogar</strong>. Inicio muestra tus tareas, la compra, el balance del mes y estadísticas.</p>
    </div>
  </div>

  <h3 style="font-size:13pt;margin:8mm 0 3mm">¿Cómo funciona la sincronización?</h3>
  <svg viewBox="0 0 640 150" width="100%" role="img" aria-label="Todos los móviles del hogar comparten los mismos datos en la nube">
    <g font-family="Plus Jakarta Sans, sans-serif" text-anchor="middle">
      <ellipse cx="320" cy="72" rx="80" ry="44" fill="#e8edf6" stroke="#4f6fa3" stroke-width="2"/>
      <text x="320" y="66" font-size="15" font-weight="800" fill="#1f2e47">Tu hogar</text>
      <text x="320" y="86" font-size="11" fill="#4a5468">en la nube</text>
      <g fill="#fff" stroke="#4f6fa3" stroke-width="2">
        <rect x="40" y="30" width="54" height="90" rx="10"/><rect x="546" y="30" width="54" height="90" rx="10"/>
        <rect x="150" y="12" width="44" height="74" rx="9"/><rect x="446" y="12" width="44" height="74" rx="9"/>
      </g>
      <text x="67" y="82" font-size="22">👩</text><text x="573" y="82" font-size="22">👨</text>
      <text x="172" y="57" font-size="18">🧑</text><text x="468" y="57" font-size="18">👵</text>
      <g stroke="#4f6fa3" stroke-width="2" fill="none" marker-end="url(#fl)" marker-start="url(#fl)">
        <path d="M100 75 H236"/><path d="M540 75 H404"/><path d="M198 50 L250 60"/><path d="M442 50 L390 60"/>
      </g>
      <defs><marker id="fl" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" fill="#4f6fa3"/></marker></defs>
      <text x="320" y="142" font-size="11.5" fill="#4a5468">Lo que apunta uno lo ven todos al instante: tareas, gastos y la lista de la compra.</text>
    </g>
  </svg>

  <div class="consejo mt-auto"><span class="ico">💡</span><div>El plan gratuito admite <strong>2 personas por hogar</strong>. Si sois más, con <strong>HogarPlus</strong> no hay límite, y lo disfruta toda la casa.</div></div>
  <div class="pie"><span>Manual de HogarGo</span><span>3</span></div>
</section>

<!-- ================= 4. INICIO ================= -->
<section class="pagina" id="inicio">
  <div class="cab"><div class="num">2</div><div><h2>La pantalla de Inicio</h2><div class="sub">El resumen de tu hogar de un vistazo</div></div></div>

  <div class="fila" style="gap:9mm">
    <div class="anotada col-movil" style="width:76mm;flex:none">
      <img class="movil" src="/manual/img/01_inicio.jpg" alt="Pantalla de Inicio">
      <span class="punto" style="left:61.5%;top:23.2%">1</span>
      <span class="punto" style="left:72%;top:23.2%">2</span>
      <span class="punto" style="left:56%;top:33.2%">3</span>
      <span class="punto" style="left:29%;top:52%">4</span>
      <span class="punto" style="left:36%;top:60.3%">5</span>
      <span class="punto" style="left:36%;top:81.3%">6</span>
      <span class="punto" style="left:50%;top:85%">7</span>
    </div>
    <div class="col">
      <ul class="marcas">
        <li><span class="b">1</span><div><strong>Añadir personas</strong><span>Invita a alguien al hogar o crea un usuario sin cuenta.</span></div></li>
        <li><span class="b">2</span><div><strong>Paneles y Configuración</strong><span>El icono de ajustes abre «Mostrar / ocultar paneles»; el engranaje, Configuración.</span></div></li>
        <li><span class="b">3</span><div><strong>Ranking Semana / Mes</strong><span>Puntos de cada persona y su porcentaje del reparto.</span></div></li>
        <li><span class="b">4</span><div><strong>Mensaje de motivación</strong><span>Te avisa si alguien se queda atrás… o va en cabeza.</span></div></li>
        <li><span class="b">5</span><div><strong>Tu casa</strong><span>Tareas pendientes y atrasadas de la semana, y artículos de la compra.</span></div></li>
        <li><span class="b">6</span><div><strong>Dinero</strong><span>Saldos (quién debe a quién) y tus finanzas del mes.</span></div></li>
        <li><span class="b">7</span><div><strong>Barra inferior y botón +</strong><span>Navega entre secciones y crea lo propio de cada una.</span></div></li>
      </ul>
    </div>
  </div>

  <h3 style="font-size:13pt;margin:7mm 0 3mm">Personaliza tu Inicio</h3>
  <div class="fila">
    <div class="tarjeta col"><h3>👁️ Elige qué ver</h3><p>Activa o desactiva cada tarjeta: ranking, tareas, compra, saldos, finanzas y estadísticas.</p></div>
    <div class="tarjeta col"><h3>↕️ Ordena a tu gusto</h3><p>Mantén pulsada una tarjeta y arrástrala para cambiar su posición.</p></div>
    <div class="tarjeta col"><h3>👤 Cada uno, el suyo</h3><p>La configuración del Inicio es personal: no cambia la de los demás.</p></div>
  </div>
  <div class="pie"><span>Manual de HogarGo</span><span>4</span></div>
</section>

<!-- ================= 5. TAREAS ================= -->
<section class="pagina" id="tareas" style="--c:var(--lila);--cc:var(--lila-claro)">
  <div class="cab"><div class="num">3</div><div><h2>Tareas y puntos</h2><div class="sub">Repartir las tareas deja de ser una discusión y se convierte en un juego</div></div></div>

  <div class="fila" style="gap:8mm;align-items:center">
    <div class="col">
      <!-- Infografía: ciclo de una tarea -->
      <svg viewBox="0 0 340 330" width="100%" role="img" aria-label="Ciclo de una tarea: crear, asignar, marcar como hecha, sumar puntos y subir en el ranking">
        <defs><marker id="fll" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10z" fill="#7f77dd"/></marker></defs>
        <circle cx="170" cy="165" r="112" fill="none" stroke="#c9c5f1" stroke-width="3" stroke-dasharray="6 6"/>
        <g stroke="#7f77dd" stroke-width="3" fill="none" marker-end="url(#fll)">
          <path d="M210 60 A112 112 0 0 1 270 120"/>
          <path d="M282 205 A112 112 0 0 1 225 262"/>
          <path d="M120 270 A112 112 0 0 1 64 214"/>
          <path d="M60 120 A112 112 0 0 1 125 60"/>
        </g>
        <g font-family="Plus Jakarta Sans, sans-serif" text-anchor="middle">
          <circle cx="170" cy="165" r="56" fill="#7f77dd"/>
          <text x="170" y="160" font-size="26">🏆</text>
          <text x="170" y="186" font-size="12" font-weight="800" fill="#fff">Ranking</text>
          <g><circle cx="170" cy="50" r="34" fill="#ecebfa" stroke="#7f77dd" stroke-width="2.5"/><text x="170" y="50" font-size="20">📝</text><text x="170" y="68" font-size="10" font-weight="700" fill="#1f2e47">Crear</text></g>
          <g><circle cx="288" cy="165" r="34" fill="#ecebfa" stroke="#7f77dd" stroke-width="2.5"/><text x="288" y="165" font-size="20">👥</text><text x="288" y="183" font-size="10" font-weight="700" fill="#1f2e47">Asignar</text></g>
          <g><circle cx="170" cy="282" r="34" fill="#ecebfa" stroke="#7f77dd" stroke-width="2.5"/><text x="170" y="282" font-size="20">✅</text><text x="170" y="300" font-size="10" font-weight="700" fill="#1f2e47">Marcar</text></g>
          <g><circle cx="52" cy="165" r="34" fill="#ecebfa" stroke="#7f77dd" stroke-width="2.5"/><text x="52" y="165" font-size="20">⭐</text><text x="52" y="183" font-size="10" font-weight="700" fill="#1f2e47">+ Puntos</text></g>
        </g>
      </svg>
    </div>
    <div class="col">
      <ul class="marcas">
        <li><span class="b">1</span><div><strong>Crea la tarea</strong><span>Nombre, categoría y puntos. Cuanto más pesada, más puntos.</span></div></li>
        <li><span class="b">2</span><div><strong>Asígnala</strong><span>A una o varias personas, o prográmala en el planificador.</span></div></li>
        <li><span class="b">3</span><div><strong>Márcala como hecha</strong><span>En un toque, desde el marcador de tareas: programadas o sin planificar.</span></div></li>
        <li><span class="b">4</span><div><strong>Suma puntos</strong><span>Los puntos van al ranking semanal y mensual del hogar.</span></div></li>
      </ul>
    </div>
  </div>

  <h3 style="font-size:13pt;margin:4mm 0 3mm">Categorías de tareas</h3>
  <div class="fila" style="gap:4mm">
    <div class="tarjeta col" style="background:#e0f3ec;border-color:#bfe3d5;text-align:center"><div style="font-size:20pt">🍳</div><h3 style="color:#167a5b;margin:0">Cocina</h3></div>
    <div class="tarjeta col" style="background:#ecebfa;border-color:#d5d2f3;text-align:center"><div style="font-size:20pt">🧽</div><h3 style="color:#5c54b8;margin:0">Limpieza</h3></div>
    <div class="tarjeta col" style="background:#fbe9e1;border-color:#f3cdbd;text-align:center"><div style="font-size:20pt">👕</div><h3 style="color:#b0461f;margin:0">Ropa</h3></div>
    <div class="tarjeta col" style="background:#f6ecdc;border-color:#ebd6b4;text-align:center"><div style="font-size:20pt">📦</div><h3 style="color:#94600f;margin:0">Otros</h3></div>
  </div>

  <div class="fila mt" style="gap:8mm;align-items:center">
    <div class="col-movil" style="width:55mm;flex:none"><img class="movil" src="/manual/img/02_tareas.jpg" alt="Pantalla de tareas"></div>
    <div class="col">
