    display: inline-flex; align-items: center; gap: 8px;
    padding: 9px 16px; border-radius: 999px;
    background: var(--bronce); color: var(--marca-muy-osc);
    font-weight: 700; font-size: 14px; text-decoration: none; white-space: nowrap;
  }
  .btn-pdf:hover { background: #d6bb94; }

  /* ---------- Páginas A4 ---------- */
  .paginas { padding: 24px 16px 48px; display: flex; flex-direction: column; align-items: center; gap: 24px; }
  .pagina {
    position: relative;
    width: 210mm; height: 297mm;
    padding: 15mm 16mm 18mm;
    background: #fff;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(31, 46, 71, .18);
    border-radius: 4px;
    display: flex; flex-direction: column;
  }
