    --tarjeta: #f5f8fd;
    --borde: #d3dde9;
    --texto: #1f2e47;
    --texto-2: #4a5468;
    --bronce: #c8a97e;
    --bronce-osc: #9b7a52;
    --bronce-claro: #f3ece3;
    --verde: #1d9e75;
    --verde-claro: #e0f3ec;
    --naranja: #d85a30;
    --naranja-claro: #fbe9e1;
    --lila: #7f77dd;
    --lila-claro: #ecebfa;
    --ocre: #ba7517;
    --ocre-claro: #f6ecdc;
    --rojo: #c0392b;
    --rojo-claro: #fbe4e1;
    --fondo-web: #dfe6f1;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) { --fondo-web: #121417; }
  }
  :root[data-theme="dark"] { --fondo-web: #121417; }

  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body {
    margin: 0;
