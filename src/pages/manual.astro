    border-top: 1px solid var(--borde); padding-top: 2.5mm;
  }

  @page { size: A4; margin: 0; }
  @media print {
    body { background: #fff; }
    .barra-web { display: none; }
    .paginas { padding: 0; gap: 0; display: block; }
