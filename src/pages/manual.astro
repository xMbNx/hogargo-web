  .pilar span { font-size: 8.5pt; opacity: .85; line-height: 1.35; display: block; }

  /* ---------- Índice ---------- */
  .indice { display: grid; grid-template-columns: 1fr 1fr; gap: 3mm 6mm; }
  .indice a {
    display: flex; align-items: center; gap: 3.5mm; padding: 3mm 4mm;
