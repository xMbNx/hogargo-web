  .paso h4 { font-size: 10pt; margin-bottom: 1mm; }
  .paso p { font-size: 8.5pt; line-height: 1.4; margin: 0; }
  .paso:not(:last-child)::after {
    content: ""; position: absolute; top: 8.5mm; left: calc(50% + 9mm); right: calc(-50% + 9mm);
    border-top: 2px dashed var(--c, var(--marca)); opacity: .55;
  }

  /* Callouts sobre captura */
  .anotada { position: relative; }
  .marcas { list-style: none; padding: 0; margin: 0; }
  .marcas li { display: flex; gap: 3mm; margin-bottom: 3.2mm; align-items: flex-start; }
  .marcas .b {
    flex: none; width: 6.5mm; height: 6.5mm; border-radius: 50%;
    background: var(--c, var(--marca)); color: #fff;
    display: grid; place-items: center; font-size: 8.5pt; font-weight: 800; margin-top: .3mm;
  }
  .marcas strong { display: block; font-size: 10pt; }
  .marcas span { font-size: 9pt; color: var(--texto-2); line-height: 1.4; display: block; }
  .punto {
    position: absolute; width: 7mm; height: 7mm; border-radius: 50%;
    background: var(--c, var(--marca)); color: #fff; border: 2px solid #fff;
    display: grid; place-items: center; font-size: 8.5pt; font-weight: 800;
    box-shadow: 0 2px 6px rgba(0, 0, 0, .3);
    transform: translate(-50%, -50%);
  }
  .pasos.vertical .paso::after { display: none; }

  /* ---------- Portada ---------- */
  .portada {
    background: linear-gradient(160deg, #6a89bd 0%, #4f6fa3 40%, #2c4266 100%);
    color: #fff; padding: 20mm 18mm;
  }
  .portada .pie { color: rgba(255, 255, 255, .7); border-color: rgba(255, 255, 255, .25); }
  .portada .logo { width: 22mm; height: 22mm; border-radius: 5mm; box-shadow: 0 6px 18px rgba(0, 0, 0, .25); }
  .portada .tipo { margin-top: 10mm; font-size: 11pt; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; opacity: .85; }
  .portada h1 { font-size: 46pt; font-weight: 800; margin-top: 2mm; letter-spacing: -.02em; }
  .portada .lema { font-size: 15pt; opacity: .92; margin-top: 3mm; max-width: 110mm; line-height: 1.35; }
  .portada .version { align-self: flex-start; margin-top: 6mm; padding: 1.2mm 4mm; border-radius: 99px; background: rgba(255, 255, 255, .16); font-size: 9.5pt; font-weight: 600; }
