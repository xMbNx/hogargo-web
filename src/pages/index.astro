        <div class="tuto" id="tuto">
          <div class="tuto__tabs" role="tablist" aria-label="Tutoriales">
            {
              tutoriales.map((t, i) => (
                <button
                  class="tab"
                  role="tab"
                  type="button"
                  id={`tab-${t.id}`}
                  aria-controls={`panel-${t.id}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                  data-tab={t.id}
                >
                  <span class="tab__icon" aria-hidden="true">{t.icono}</span>
                  <span class="tab__name">{t.nombre}</span>
                  <span class="tab__sub">{t.resumen}</span>
                </button>
              ))
            }
          </div>

          {
            tutoriales.map((t, i) => (
              <div
                class="panel"
                role="tabpanel"
                id={`panel-${t.id}`}
                aria-labelledby={`tab-${t.id}`}
                data-panel={t.id}
                hidden={i !== 0}
              >
                <h3 class="panel__title">{t.nombre}</h3>
                <div class="steps">
                  {t.pasos.map((p, j) => (
                    <article class="step" data-step={j} hidden={j !== 0}>
                      <div class="step__shot">
                        <img
                          src={p.imagen}
                          alt={`${t.nombre}, paso ${j + 1}: ${p.titulo}`}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <div class="step__body">
                        <span class="step__num">Paso {j + 1} de {t.pasos.length}</span>
                        <h4>{p.titulo}</h4>
                        <p>{p.descripcion}</p>
                      </div>
                    </article>
                  ))}
                </div>

                <div class="controls">
                  <button class="nav-btn" type="button" data-prev aria-label="Paso anterior">←</button>
                  <div class="dots" role="group" aria-label="Pasos">
                    {t.pasos.map((p, j) => (
                      <button
                        class="dot"
                        type="button"
                        data-dot={j}
                        aria-label={`Ir al paso ${j + 1}: ${p.titulo}`}
                        aria-current={j === 0 ? "step" : "false"}
                      />
                    ))}
                  </div>
                  <button class="nav-btn" type="button" data-next aria-label="Paso siguiente">→</button>
                </div>
                <div class="progress" aria-hidden="true"><i></i></div>
              </div>
            ))
          }

          <div class="tuto__cta">
            <p>¿Lo has visto claro? Pruébalo tú mismo.</p>
            <a class="tuto__manual" href="/manual">¿Quieres más detalle? Consulta el manual completo →</a>
            <a class="btn" href={playStoreUrl} target="_blank" rel="noopener noreferrer">
              📲 Descargar en Google Play
            </a>
          </div>
        </div>
      </section>

