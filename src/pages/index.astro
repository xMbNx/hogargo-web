      📲 Descargar en Google Play
    </a>

    <script>
      // Aparición al hacer scroll + nav con sombra
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const reveals = document.querySelectorAll<HTMLElement>(".reveal");
      if (reduce || !("IntersectionObserver" in window)) {
        reveals.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        reveals.forEach((el) => io.observe(el));
      }

      const nav = document.getElementById("nav");
      const onScroll = () => nav?.classList.toggle("nav--solid", window.scrollY > 12);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // Tutoriales interactivos
      const root = document.getElementById("tuto")!;
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".tab"));
      const panels = Array.from(root.querySelectorAll<HTMLElement>(".panel"));
      const state: Record<string, number> = {};

      function showStep(panel: HTMLElement, index: number) {
        const steps = Array.from(panel.querySelectorAll<HTMLElement>(".step"));
        const i = Math.max(0, Math.min(index, steps.length - 1));
        state[panel.dataset.panel!] = i;
        steps.forEach((s, k) => {
          s.hidden = k !== i;
          if (k === i && !reduce) {
            s.classList.remove("step--in");
            void s.offsetWidth;
            s.classList.add("step--in");
          }
        });
        panel.querySelectorAll<HTMLElement>(".dot").forEach((d, k) => {
          d.setAttribute("aria-current", k === i ? "step" : "false");
        });
        const bar = panel.querySelector<HTMLElement>(".progress i");
        if (bar) bar.style.width = `${((i + 1) / steps.length) * 100}%`;
        panel.querySelector<HTMLButtonElement>("[data-prev]")!.disabled = i === 0;
        panel.querySelector<HTMLButtonElement>("[data-next]")!.disabled = i === steps.length - 1;
      }

      function showTab(id: string, focus = false) {
        tabs.forEach((t) => {
          const on = t.dataset.tab === id;
          t.setAttribute("aria-selected", String(on));
          t.tabIndex = on ? 0 : -1;
          if (on && focus) t.focus();
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.panel !== id;
          if (!p.hidden) showStep(p, state[id] ?? 0);
        });
      }

      tabs.forEach((t, i) => {
        t.addEventListener("click", () => showTab(t.dataset.tab!));
        t.addEventListener("keydown", (e) => {
          const k = (e as KeyboardEvent).key;
          if (k !== "ArrowRight" && k !== "ArrowLeft") return;
          e.preventDefault();
          const n = (i + (k === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
          showTab(tabs[n].dataset.tab!, true);
        });
      });

      panels.forEach((p) => {
        const go = (d: number) => showStep(p, (state[p.dataset.panel!] ?? 0) + d);
        p.querySelector("[data-prev]")!.addEventListener("click", () => go(-1));
        p.querySelector("[data-next]")!.addEventListener("click", () => go(1));
        p.querySelectorAll<HTMLElement>("[data-dot]").forEach((d) =>
          d.addEventListener("click", () => showStep(p, Number(d.dataset.dot))),
        );

        // Gesto de deslizar en móvil
        let x0 = 0;
        const area = p.querySelector<HTMLElement>(".steps")!;
        area.addEventListener("touchstart", (e) => (x0 = e.touches[0].clientX), { passive: true });
        area.addEventListener("touchend", (e) => {
          const dx = e.changedTouches[0].clientX - x0;
          if (Math.abs(dx) > 50) go(dx < 0 ? 1 : -1);
        });
        showStep(p, 0);
      });
    </script>
  </body>
</html>

