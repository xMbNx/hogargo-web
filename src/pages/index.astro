---
import { tutoriales, funciones } from "../data/tutoriales";
import { pasosInicio, formasDeSumar, comparativa, planes, faqs } from "../data/guia";

const playStoreUrl = "https://play.google.com/store/apps/details?id=com.mbn.hogargo";
const title = "HogarGo | Tareas, planificador, compras y economía compartida del hogar";
const description =
  "Organiza tareas del hogar, listas de compra, economía compartida y planificación familiar con HogarGo. Descárgala gratis en Google Play.";
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const manualTemas = [
  { id: "primeros-pasos", icono: "🚀", nombre: "Primeros pasos" },
  { id: "inicio", icono: "🏠", nombre: "Pantalla de Inicio" },
  { id: "tareas", icono: "✅", nombre: "Tareas y puntos" },
  { id: "planificador", icono: "📅", nombre: "Planificador" },
  { id: "logros", icono: "🏆", nombre: "Logros y retos" },
  { id: "recompensas", icono: "🎁", nombre: "Recompensas" },
  { id: "gastos", icono: "💶", nombre: "Gastos compartidos" },
  { id: "economia-avanzada", icono: "🧾", nombre: "Economía en automático" },
  { id: "finanzas", icono: "💼", nombre: "Finanzas personales" },
  { id: "compra", icono: "🛒", nombre: "Lista de la compra" },
  { id: "widget", icono: "📲", nombre: "Widget y avisos" },
  { id: "configuracion", icono: "⚙️", nombre: "Configuración" },
  { id: "hogarplus", icono: "⭐", nombre: "HogarPlus" },
  { id: "ayuda", icono: "❓", nombre: "Preguntas frecuentes" },
];
const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#005cff" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logoandroid.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs("/presentacion.png")} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <script type="application/ld+json" set:html={faqJsonLd} />
  </head>

  <body>
    <header class="nav" id="nav">
      <a class="nav__brand" href="#inicio" aria-label="HogarGo, inicio">
        <img src="/logoandroid.png" alt="" width="40" height="40" />
        <span>HogarGo</span>
      </a>
      <nav class="nav__links" aria-label="Principal">
        <a href="#funciones">Funciones</a>
        <a class="nav__extra" href="#como-funciona">Cómo funciona</a>
        <a href="#tutoriales">Tutoriales</a>
        <a class="nav__extra" href="#hogarplus">HogarPlus</a>
        <a href="/manual">Manual</a>
      </nav>
      <a class="btn btn--small" href={playStoreUrl} target="_blank" rel="noopener noreferrer">
        Descargar
      </a>
    </header>

    <main id="inicio">
      <!-- HERO -->
      <section class="hero">
        <div class="hero__text reveal">
          <span class="chip">📱 App para Android · Gratis</span>
          <h1>Todo tu hogar,<br /><span class="grad">en una sola app</span></h1>
          <p class="lead">
            Tareas, compras, economía compartida y planificación. Todos en casa
            organizados, sin discusiones y sin hojas de cálculo.
          </p>

          <a
            class="play"
            href={playStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Descargar HogarGo en Google Play"
          >
            <svg class="play__logo" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#00d1ff" d="M3.6 1.6c-.3.3-.5.8-.5 1.4v18c0 .6.2 1.1.5 1.4l.1.1L14 12.2v-.4L3.7 1.5z" />
              <path fill="#00e676" d="M17.4 15.6 14 12.2v-.4l3.4-3.4.1.1 4 2.3c1.1.6 1.1 1.7 0 2.4l-4 2.3z" />
              <path fill="#ff3d5a" d="m17.5 15.5-3.5-3.5L3.6 22.4c.4.4 1 .4 1.7.1z" />
              <path fill="#ffc400" d="M17.5 8.5 5.3 1.5c-.7-.4-1.3-.3-1.7.1L14 12z" />
            </svg>
            <span class="play__text">
              <small>DISPONIBLE EN</small>
              <strong>Google Play</strong>
            </span>
          </a>

          <ul class="trust">
            <li>✔ Hogares compartidos</li>
            <li>✔ Modo «Un usuario»</li>
            <li>✔ Logros y retos</li>
            <li>✔ Modo oscuro</li>
            <li>✔ 9 idiomas</li>
          </ul>
        </div>

        <div class="hero__visual reveal" style="--d: 120ms">
          <div class="glow" aria-hidden="true"></div>
          <img
            class="poster"
            src="/presentacion.webp"
            alt="Pantallas de HogarGo: tareas, lista de la compra y economía compartida"
            width="1200"
            height="1200"
            fetchpriority="high"
          />
        </div>
      </section>

      <!-- FUNCIONES -->
      <section class="section" id="funciones">
        <div class="section__head reveal">
          <span class="chip">Qué puedes hacer</span>
          <h2>Una app, todo el hogar</h2>
          <p>Cada parte de la casa, en el bolsillo de cada persona.</p>
        </div>
        <div class="grid">
          {
            funciones.map((f, i) => (
              <article class="card reveal" style={`--d:${i * 70}ms`}>
                <span class="card__icon" aria-hidden="true">{f.icono}</span>
                <h3>{f.titulo}</h3>
                <p>{f.texto}</p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- CÓMO EMPEZAR -->
      <section class="section section--tint" id="empezar">
        <div class="section__head reveal">
          <span class="chip">Primeros pasos</span>
          <h2>Tu hogar listo en cuatro pasos</h2>
          <p>De la descarga a tener a toda la casa organizada, en un par de minutos.</p>
        </div>

        <ol class="arranque">
          {
            pasosInicio.map((p, i) => (
              <li class="arranque__paso reveal" style={`--d:${i * 90}ms`}>
                <span class="arranque__circ" aria-hidden="true">
                  {p.icono}
                  <b>{i + 1}</b>
                </span>
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </li>
            ))
          }
        </ol>

        <h3 class="sub-head reveal">Tres formas de sumar personas</h3>
        <div class="formas">
          {
            formasDeSumar.map((f, i) => (
              <article class="card reveal" style={`--d:${i * 70}ms`}>
                <span class="card__icon" aria-hidden="true">{f.icono}</span>
                <h3>{f.titulo}</h3>
                <p>{f.texto}</p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- CÓMO FUNCIONA -->
      <section class="section" id="como-funciona">
        <div class="section__head reveal">
          <span class="chip">Cómo funciona</span>
          <h2>Cada parte de la casa, explicada</h2>
          <p>Las mismas infografías del manual, para que veas de un vistazo qué hace HogarGo por ti.</p>
        </div>

        <div class="feats">
          <!-- Tareas y puntos -->
          <article class="feat reveal" style="--c:#7f77dd;--cc:#ecebfa">
            <div class="feat__media">
              <svg viewBox="0 0 340 330" role="img" aria-label="Ciclo de una tarea: crear, asignar, marcar como hecha, sumar puntos y subir en el ranking">
                <defs><marker id="fl-tareas" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10z" fill="#7f77dd" /></marker></defs>
                <circle cx="170" cy="165" r="112" fill="none" stroke="#c9c5f1" stroke-width="3" stroke-dasharray="6 6" />
                <g stroke="#7f77dd" stroke-width="3" fill="none" marker-end="url(#fl-tareas)">
                  <path d="M210 60 A112 112 0 0 1 270 120" />
                  <path d="M282 205 A112 112 0 0 1 225 262" />
                  <path d="M120 270 A112 112 0 0 1 64 214" />
                  <path d="M60 120 A112 112 0 0 1 125 60" />
                </g>
                <g font-family="Inter, system-ui, sans-serif" text-anchor="middle">
                  <circle cx="170" cy="165" r="56" fill="#7f77dd" />
                  <text x="170" y="160" font-size="26">🏆</text>
                  <text x="170" y="186" font-size="13" font-weight="800" fill="#fff">Ranking</text>
                  <circle cx="170" cy="50" r="34" fill="#ecebfa" stroke="#7f77dd" stroke-width="2.5" />
                  <text x="170" y="50" font-size="20">📝</text><text x="170" y="69" font-size="11" font-weight="700" fill="#07172f">Crear</text>
                  <circle cx="288" cy="165" r="34" fill="#ecebfa" stroke="#7f77dd" stroke-width="2.5" />
                  <text x="288" y="165" font-size="20">👥</text><text x="288" y="184" font-size="11" font-weight="700" fill="#07172f">Asignar</text>
                  <circle cx="170" cy="282" r="34" fill="#ecebfa" stroke="#7f77dd" stroke-width="2.5" />
                  <text x="170" y="282" font-size="20">✅</text><text x="170" y="301" font-size="11" font-weight="700" fill="#07172f">Marcar</text>
                  <circle cx="52" cy="165" r="34" fill="#ecebfa" stroke="#7f77dd" stroke-width="2.5" />
                  <text x="52" y="165" font-size="20">⭐</text><text x="52" y="184" font-size="11" font-weight="700" fill="#07172f">+ Puntos</text>
                </g>
              </svg>
            </div>
            <div class="feat__text">
              <span class="feat__tag">Tareas y puntos</span>
              <h3>Repartir tareas deja de ser una discusión</h3>
              <ol class="feat__list">
                <li><strong>Crea la tarea</strong> con categoría y puntos: cuanto más pesada, más puntos.</li>
                <li><strong>Asígnala</strong> a una o varias personas, o prográmala.</li>
                <li><strong>Márcala como hecha</strong> en un toque.</li>
                <li><strong>Suma puntos</strong> al ranking semanal y mensual del hogar.</li>
              </ol>
              <ul class="cats" aria-label="Categorías de tareas">
                <li style="--k:#1d9e75">🍳 Cocina</li>
                <li style="--k:#7f77dd">🧽 Limpieza</li>
                <li style="--k:#d85a30">👕 Ropa</li>
                <li style="--k:#ba7517">📦 Otros</li>
              </ul>
              <a class="feat__more" href="/manual#tareas">Ver en el manual →</a>
            </div>
          </article>

          <!-- Planificador -->
          <article class="feat feat--rev reveal" style="--c:#7f77dd;--cc:#ecebfa">
            <div class="feat__media">
              <svg viewBox="0 0 400 250" role="img" aria-label="Planificador en tres pasos: cuándo, quién y qué, con modos de repetición semanal, selección de días, todo el mes y todo el año">
                <g font-family="Inter, system-ui, sans-serif" text-anchor="middle">
                  <g stroke="#7f77dd" stroke-width="2" stroke-dasharray="5 5" opacity=".6">
                    <line x1="102" y1="46" x2="168" y2="46" /><line x1="232" y1="46" x2="298" y2="46" />
                  </g>
                  <g fill="#ecebfa" stroke="#7f77dd" stroke-width="2.5">
                    <circle cx="70" cy="46" r="30" /><circle cx="200" cy="46" r="30" /><circle cx="330" cy="46" r="30" />
                  </g>
                  <g font-size="24"><text x="70" y="55">📅</text><text x="200" y="55">🙋</text><text x="330" y="55">📋</text></g>
                  <g font-size="13" font-weight="800" fill="#07172f"><text x="70" y="96">Cuándo</text><text x="200" y="96">Quién</text><text x="330" y="96">Qué</text></g>
                  <g font-size="10.5" fill="#38506d"><text x="70" y="112">Días</text><text x="200" y="112">Usuarios</text><text x="330" y="112">Tareas</text></g>
                  <g font-size="11" font-weight="700" fill="#38506d">
                    <text x="50" y="144">L</text><text x="100" y="144">M</text><text x="150" y="144">X</text><text x="200" y="144">J</text><text x="250" y="144">V</text><text x="300" y="144">S</text><text x="350" y="144">D</text>
                  </g>
                  <g fill="#ecebfa">
                    <rect x="82" y="152" width="36" height="30" rx="8" /><rect x="182" y="152" width="36" height="30" rx="8" /><rect x="282" y="152" width="36" height="30" rx="8" /><rect x="332" y="152" width="36" height="30" rx="8" />
                  </g>
                  <g fill="#7f77dd">
                    <rect x="32" y="152" width="36" height="30" rx="8" /><rect x="132" y="152" width="36" height="30" rx="8" /><rect x="232" y="152" width="36" height="30" rx="8" />
                  </g>
                  <g fill="#fff" font-size="14" font-weight="800"><text x="50" y="172">✓</text><text x="150" y="172">✓</text><text x="250" y="172">✓</text></g>
                  <g font-size="11" font-weight="700">
                    <rect x="20" y="206" width="70" height="28" rx="14" fill="#7f77dd" /><text x="55" y="224" fill="#fff">Semanal</text>
                    <rect x="98" y="206" width="78" height="28" rx="14" fill="#ecebfa" /><text x="137" y="224" fill="#5c54b8">Selección</text>
                    <rect x="184" y="206" width="88" height="28" rx="14" fill="#ecebfa" /><text x="228" y="224" fill="#5c54b8">Todo el mes</text>
                    <rect x="280" y="206" width="100" height="28" rx="14" fill="#f3ece3" stroke="#c8a97e" /><text x="330" y="224" fill="#9b7a52">Todo el año ⭐</text>
                  </g>
                </g>
              </svg>
            </div>
            <div class="feat__text">
              <span class="feat__tag">Planificador e historial</span>
              <h3>Cuándo, quién y qué, en tres toques</h3>
              <p>Elige los días, las personas y las tareas. Repite la planificación cada semana, en días sueltos, el mes entero o, con HogarPlus, el año completo.</p>
              <ul class="feat__checks">
                <li><strong>Reparto automático</strong> con HogarPlus: cada tarea va a quien menos puntos lleva.</li>
                <li>Calendario de asignaciones de cada persona.</li>
                <li>Historial por día y persona, con filtros por usuario, tipo o mes (30 días en el plan gratuito).</li>
                <li>Toca un registro para editarlo o deslízalo para borrarlo.</li>
              </ul>
              <a class="feat__more" href="/manual#planificador">Ver en el manual →</a>
            </div>
          </article>

          <!-- Logros y retos -->
          <article class="feat reveal" style="--c:#ba7517;--cc:#f6ecdc">
            <div class="feat__media">
              <svg viewBox="0 0 400 290" role="img" aria-label="Ejemplo: nivel 4 con 420 de 500 puntos, reto del hogar con 8 de 10 tareas y racha de 5 días">
                <g font-family="Inter, system-ui, sans-serif">
                  <rect x="0" y="0" width="400" height="84" rx="14" fill="#fff" stroke="#ebd6b4" />
                  <text x="14" y="32" font-size="19">🎖️</text>
                  <text x="46" y="31" font-size="15" font-weight="800" fill="#07172f">Nivel 4</text>
                  <text x="386" y="31" font-size="12" fill="#38506d" text-anchor="end">420 / 500 pts</text>
                  <rect x="14" y="46" width="372" height="10" rx="5" fill="#f6ecdc" /><rect x="14" y="46" width="223" height="10" rx="5" fill="#ba7517" />
                  <text x="14" y="74" font-size="10.5" fill="#38506d">Tus puntos de siempre suben tu nivel, hasta el 50</text>
                  <rect x="0" y="96" width="400" height="84" rx="14" fill="#fff" stroke="#bfe3d5" />
                  <text x="14" y="128" font-size="19">🙌</text>
                  <text x="46" y="127" font-size="15" font-weight="800" fill="#07172f">Reto del hogar</text>
                  <text x="386" y="127" font-size="12" fill="#38506d" text-anchor="end">8 de 10</text>
                  <rect x="14" y="142" width="372" height="10" rx="5" fill="#e0f3ec" /><rect x="14" y="142" width="298" height="10" rx="5" fill="#1d9e75" />
                  <text x="14" y="170" font-size="10.5" fill="#38506d">5 tareas por persona a la semana · +20 pts para cada uno</text>
                  <rect x="0" y="192" width="400" height="94" rx="14" fill="#fff" stroke="#f3cdbd" />
                  <text x="14" y="214" font-size="13" font-weight="800" fill="#07172f">Racha de 5 días</text>
                  <g fill="#fbe9e1" stroke="#d85a30" stroke-width="2">
                    <circle cx="40" cy="246" r="19" /><circle cx="93" cy="246" r="19" /><circle cx="146" cy="246" r="19" /><circle cx="199" cy="246" r="19" /><circle cx="252" cy="246" r="19" />
                  </g>
                  <g fill="none" stroke="#e8b9a6" stroke-width="2" stroke-dasharray="4 4"><circle cx="305" cy="246" r="19" /><circle cx="358" cy="246" r="19" /></g>
                  <g text-anchor="middle" font-size="17"><text x="40" y="252">🔥</text><text x="93" y="252">🔥</text><text x="146" y="252">🔥</text><text x="199" y="252">🔥</text><text x="252" y="252">🔥</text></g>
                  <g text-anchor="middle" font-size="10" font-weight="700" fill="#38506d"><text x="40" y="280">L</text><text x="93" y="280">M</text><text x="146" y="280">X</text><text x="199" y="280">J</text><text x="252" y="280">V</text><text x="305" y="280">S</text><text x="358" y="280">D</text></g>
                </g>
              </svg>
            </div>
            <div class="feat__text">
              <span class="feat__tag">Logros y retos</span>
              <h3>Cada tarea te acerca a algo</h3>
              <ul class="feat__checks">
                <li><strong>Racha:</strong> días seguidos con al menos una tarea. Si hoy aún no has hecho ninguna, te avisa.</li>
                <li><strong>Nivel:</strong> tus puntos de siempre te hacen subir.</li>
                <li><strong>39 insignias</strong> de tareas y de economía, algunas secretas. Compártelas con una imagen.</li>
                <li><strong>Reto del hogar:</strong> un objetivo semanal entre todos, con +20 puntos para cada uno.</li>
              </ul>
              <a class="feat__more" href="/manual#logros">Ver en el manual →</a>
            </div>
          </article>

          <!-- Recompensas -->
          <article class="feat feat--rev reveal" style="--c:#9b7a52;--cc:#f3ece3">
            <div class="feat__media">
              <svg viewBox="0 0 400 270" role="img" aria-label="Puntos para canjear: 95 de tareas más 40 de retos menos 50 canjeados, 85 puntos. Premios: elegir el postre 30, noche de peli 50 y librarse de fregar 80">
                <g font-family="Inter, system-ui, sans-serif">
                  <rect x="0" y="0" width="400" height="150" rx="16" fill="#fff" stroke="#e6d6bf" />
                  <g font-size="13" fill="#07172f"><text x="18" y="30">✅  Puntos de tareas</text><text x="18" y="58">🙌  Bonos de retos</text><text x="18" y="86">🎁  Ya canjeado</text></g>
                  <g font-size="13" font-weight="800" text-anchor="end"><text x="382" y="30" fill="#1d9e75">+ 95</text><text x="382" y="58" fill="#1d9e75">+ 40</text><text x="382" y="86" fill="#c0392b">− 50</text></g>
                  <line x1="18" y1="100" x2="382" y2="100" stroke="#9b7a52" stroke-width="1.5" />
                  <text x="18" y="132" font-size="15" font-weight="800" fill="#07172f">Para canjear</text>
                  <text x="382" y="134" font-size="20" font-weight="800" fill="#9b7a52" text-anchor="end">85 pts</text>
                  <g font-size="12.5" font-weight="700" fill="#07172f">
                    <rect x="0" y="162" width="400" height="30" rx="10" fill="#fff" stroke="#e6d6bf" /><text x="16" y="182">🍦  Elegir el postre</text>
                    <rect x="0" y="198" width="400" height="30" rx="10" fill="#fff" stroke="#e6d6bf" /><text x="16" y="218">🍿  Noche de peli</text>
                    <rect x="0" y="234" width="400" height="30" rx="10" fill="#fff" stroke="#e6d6bf" /><text x="16" y="254">🧽  Librarse de fregar</text>
                  </g>
                  <g font-size="12" font-weight="800" text-anchor="end"><text x="384" y="182" fill="#ba7517">30 pts</text><text x="384" y="218" fill="#ba7517">50 pts</text><text x="384" y="254" fill="#a3acbb">80 pts</text></g>
                </g>
              </svg>
            </div>
            <div class="feat__text">
              <span class="feat__tag">⭐ Recompensas · HogarPlus</span>
              <h3>Tus puntos valen premios</h3>
              <ol class="feat__list">
                <li><strong>Cread premios</strong> con el coste que queráis, o usad la lista sugerida.</li>
                <li><strong>Canjea</strong> con tus puntos de tareas y los bonos del reto.</li>
                <li><strong>Márcalo como entregado</strong> y consulta el historial de canjes.</li>
              </ol>
              <p class="feat__note">Canjear no baja tu ranking ni tu nivel.</p>
              <a class="feat__more" href="/manual#recompensas">Ver en el manual →</a>
            </div>
          </article>

          <!-- Gastos compartidos -->
          <article class="feat reveal" style="--c:#1d9e75;--cc:#e0f3ec">
            <div class="feat__media">
              <svg viewBox="0 0 400 300" role="img" aria-label="Ejemplo: Ana paga 60 euros de compra a medias y Juan paga 20 euros de internet a medias; resultado, Juan debe 20 euros a Ana">
                <defs><marker id="fl-gastos" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10z" fill="#1d9e75" /></marker></defs>
                <g font-family="Inter, system-ui, sans-serif">
                  <rect x="0" y="0" width="190" height="76" rx="14" fill="#f5faff" stroke="#d3e3f5" />
                  <text x="14" y="26" font-size="12.5" font-weight="800" fill="#07172f">🛒 Compra · 60 €</text>
                  <text x="14" y="46" font-size="11" fill="#38506d">Paga Ana · a medias</text>
