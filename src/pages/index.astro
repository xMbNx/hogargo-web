---
import { tutoriales, funciones } from "../data/tutoriales";

const playStoreUrl = "https://play.google.com/store/apps/details?id=com.mbn.hogargo";
const title = "HogarGo | Tareas, planificador, compras y economía compartida del hogar";
const description =
  "Organiza tareas del hogar, listas de compra, economía compartida y planificación familiar con HogarGo. Descárgala gratis en Google Play.";
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#005cff" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/logoandroid.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs("/presentacion.png")} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>

  <body>
    <header class="nav" id="nav">
      <a class="nav__brand" href="#inicio" aria-label="HogarGo, inicio">
        <img src="/logoandroid.png" alt="" width="40" height="40" />
        <span>HogarGo</span>
      </a>
      <nav class="nav__links" aria-label="Principal">
        <a href="#funciones">Funciones</a>
        <a href="#tutoriales">Tutoriales</a>
      </nav>
      <a class="btn btn--small" href={playStoreUrl} target="_blank" rel="noopener noreferrer">
        Descargar
      </a>
    </header>

    <main id="inicio">
      <!-- HERO -->
      <section class="hero">
        <div class="hero__text reveal">
          <span class="chip">📱 App para Android · Gratis</span>
          <h1>Todo tu hogar,<br /><span class="grad">en una sola app</span></h1>
          <p class="lead">
            Tareas, compras, economía compartida y planificación. Todos en casa
            organizados, sin discusiones y sin hojas de cálculo.
          </p>

          <a
            class="play"
            href={playStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Descargar HogarGo en Google Play"
          >
            <svg class="play__logo" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#00d1ff" d="M3.6 1.6c-.3.3-.5.8-.5 1.4v18c0 .6.2 1.1.5 1.4l.1.1L14 12.2v-.4L3.7 1.5z" />
              <path fill="#00e676" d="M17.4 15.6 14 12.2v-.4l3.4-3.4.1.1 4 2.3c1.1.6 1.1 1.7 0 2.4l-4 2.3z" />
              <path fill="#ff3d5a" d="m17.5 15.5-3.5-3.5L3.6 22.4c.4.4 1 .4 1.7.1z" />
              <path fill="#ffc400" d="M17.5 8.5 5.3 1.5c-.7-.4-1.3-.3-1.7.1L14 12z" />
            </svg>
            <span class="play__text">
              <small>DISPONIBLE EN</small>
              <strong>Google Play</strong>
            </span>
          </a>

          <ul class="trust">
            <li>✔ Hogares compartidos</li>
            <li>✔ Modo «Un usuario»</li>
            <li>✔ Varios idiomas</li>
          </ul>
        </div>

        <div class="hero__visual reveal" style="--d: 120ms">
          <div class="glow" aria-hidden="true"></div>
          <img
            class="poster"
            src="/presentacion.webp"
            alt="Pantallas de HogarGo: tareas, lista de la compra y economía compartida"
            width="1200"
            height="1200"
            fetchpriority="high"
          />
        </div>
      </section>

      <!-- FUNCIONES -->
      <section class="section" id="funciones">
        <div class="section__head reveal">
          <span class="chip">Qué puedes hacer</span>
          <h2>Una app, todo el hogar</h2>
          <p>Cada parte de la casa, en el bolsillo de cada persona.</p>
        </div>
        <div class="grid">
          {
            funciones.map((f, i) => (
              <article class="card reveal" style={`--d:${i * 70}ms`}>
                <span class="card__icon" aria-hidden="true">{f.icono}</span>
                <h3>{f.titulo}</h3>
                <p>{f.texto}</p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- TUTORIALES -->
      <section class="section section--tint" id="tutoriales">
        <div class="section__head reveal">
          <span class="chip">Tutoriales</span>
          <h2>Aprende HogarGo paso a paso</h2>
          <p>Elige un tema y avanza por los pasos. Son los mismos que verás dentro de la app.</p>
        </div>

        <div class="tuto" id="tuto">
          <div class="tuto__tabs" role="tablist" aria-label="Tutoriales">
            {
              tutoriales.map((t, i) => (
                <button
                  class="tab"
                  role="tab"
                  type="button"
                  id={`tab-${t.id}`}
                  aria-controls={`panel-${t.id}`}
                  aria-selected={i === 0 ? "true" : "false"}
                  tabindex={i === 0 ? 0 : -1}
                  data-tab={t.id}
                >
                  <span class="tab__icon" aria-hidden="true">{t.icono}</span>
                  <span class="tab__name">{t.nombre}</span>
                  <span class="tab__sub">{t.resumen}</span>
                </button>
              ))
            }
          </div>

          {
            tutoriales.map((t, i) => (
              <div
                class="panel"
                role="tabpanel"
                id={`panel-${t.id}`}
                aria-labelledby={`tab-${t.id}`}
                data-panel={t.id}
                hidden={i !== 0}
              >
                <h3 class="panel__title">{t.nombre}</h3>
                <div class="steps">
                  {t.pasos.map((p, j) => (
                    <article class="step" data-step={j} hidden={j !== 0}>
                      <div class="step__shot">
                        <img
                          src={p.imagen}
                          alt={`${t.nombre}, paso ${j + 1}: ${p.titulo}`}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      <div class="step__body">
                        <span class="step__num">Paso {j + 1} de {t.pasos.length}</span>
                        <h4>{p.titulo}</h4>
                        <p>{p.descripcion}</p>
                      </div>
                    </article>
                  ))}
                </div>

                <div class="controls">
                  <button class="nav-btn" type="button" data-prev aria-label="Paso anterior">←</button>
                  <div class="dots" role="group" aria-label="Pasos">
                    {t.pasos.map((p, j) => (
                      <button
                        class="dot"
                        type="button"
                        data-dot={j}
                        aria-label={`Ir al paso ${j + 1}: ${p.titulo}`}
                        aria-current={j === 0 ? "step" : "false"}
                      />
                    ))}
                  </div>
                  <button class="nav-btn" type="button" data-next aria-label="Paso siguiente">→</button>
                </div>
                <div class="progress" aria-hidden="true"><i></i></div>
              </div>
            ))
          }

          <div class="tuto__cta">
            <p>¿Lo has visto claro? Pruébalo tú mismo.</p>
            <a class="btn" href={playStoreUrl} target="_blank" rel="noopener noreferrer">
              📲 Descargar en Google Play
            </a>
          </div>
        </div>
      </section>

      <!-- CTA FINAL -->
      <section class="final">
        <div class="final__box reveal">
          <img src="/logoandroid.png" alt="" width="84" height="84" class="final__logo" />
          <h2>Pon orden en tu hogar hoy</h2>
          <p>Descarga HogarGo gratis y empieza en un par de minutos.</p>
          <a
            class="play play--light"
            href={playStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Descargar HogarGo en Google Play"
          >
            <svg class="play__logo" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#00d1ff" d="M3.6 1.6c-.3.3-.5.8-.5 1.4v18c0 .6.2 1.1.5 1.4l.1.1L14 12.2v-.4L3.7 1.5z" />
              <path fill="#00e676" d="M17.4 15.6 14 12.2v-.4l3.4-3.4.1.1 4 2.3c1.1.6 1.1 1.7 0 2.4l-4 2.3z" />
              <path fill="#ff3d5a" d="m17.5 15.5-3.5-3.5L3.6 22.4c.4.4 1 .4 1.7.1z" />
              <path fill="#ffc400" d="M17.5 8.5 5.3 1.5c-.7-.4-1.3-.3-1.7.1L14 12z" />
            </svg>
            <span class="play__text">
              <small>DISPONIBLE EN</small>
              <strong>Google Play</strong>
            </span>
          </a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <span>© 2026 HogarGo</span>
      <a href="mailto:hogargoapp@gmail.com">Contacto</a>
      <a href="/privacidad">Privacidad</a>
    </footer>

    <!-- Barra de descarga fija en móvil -->
    <a class="sticky-cta" href={playStoreUrl} target="_blank" rel="noopener noreferrer">
      📲 Descargar en Google Play
    </a>

    <script>
      // Aparición al hacer scroll + nav con sombra
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const reveals = document.querySelectorAll<HTMLElement>(".reveal");
      if (reduce || !("IntersectionObserver" in window)) {
        reveals.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        reveals.forEach((el) => io.observe(el));
      }

      const nav = document.getElementById("nav");
      const onScroll = () => nav?.classList.toggle("nav--solid", window.scrollY > 12);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });

      // Tutoriales interactivos
      const root = document.getElementById("tuto")!;
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".tab"));
      const panels = Array.from(root.querySelectorAll<HTMLElement>(".panel"));
      const state: Record<string, number> = {};

      function showStep(panel: HTMLElement, index: number) {
        const steps = Array.from(panel.querySelectorAll<HTMLElement>(".step"));
        const i = Math.max(0, Math.min(index, steps.length - 1));
        state[panel.dataset.panel!] = i;
        steps.forEach((s, k) => {
          s.hidden = k !== i;
          if (k === i && !reduce) {
            s.classList.remove("step--in");
            void s.offsetWidth;
            s.classList.add("step--in");
          }
        });
        panel.querySelectorAll<HTMLElement>(".dot").forEach((d, k) => {
          d.setAttribute("aria-current", k === i ? "step" : "false");
        });
        const bar = panel.querySelector<HTMLElement>(".progress i");
        if (bar) bar.style.width = `${((i + 1) / steps.length) * 100}%`;
        panel.querySelector<HTMLButtonElement>("[data-prev]")!.disabled = i === 0;
        panel.querySelector<HTMLButtonElement>("[data-next]")!.disabled = i === steps.length - 1;
      }

      function showTab(id: string, focus = false) {
        tabs.forEach((t) => {
          const on = t.dataset.tab === id;
          t.setAttribute("aria-selected", String(on));
          t.tabIndex = on ? 0 : -1;
          if (on && focus) t.focus();
        });
        panels.forEach((p) => {
          p.hidden = p.dataset.panel !== id;
          if (!p.hidden) showStep(p, state[id] ?? 0);
        });
      }

      tabs.forEach((t, i) => {
        t.addEventListener("click", () => showTab(t.dataset.tab!));
        t.addEventListener("keydown", (e) => {
          const k = (e as KeyboardEvent).key;
          if (k !== "ArrowRight" && k !== "ArrowLeft") return;
          e.preventDefault();
          const n = (i + (k === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
          showTab(tabs[n].dataset.tab!, true);
        });
      });

      panels.forEach((p) => {
        const go = (d: number) => showStep(p, (state[p.dataset.panel!] ?? 0) + d);
        p.querySelector("[data-prev]")!.addEventListener("click", () => go(-1));
        p.querySelector("[data-next]")!.addEventListener("click", () => go(1));
        p.querySelectorAll<HTMLElement>("[data-dot]").forEach((d) =>
          d.addEventListener("click", () => showStep(p, Number(d.dataset.dot))),
        );

        // Gesto de deslizar en móvil
        let x0 = 0;
        const area = p.querySelector<HTMLElement>(".steps")!;
        area.addEventListener("touchstart", (e) => (x0 = e.touches[0].clientX), { passive: true });
        area.addEventListener("touchend", (e) => {
          const dx = e.changedTouches[0].clientX - x0;
          if (Math.abs(dx) > 50) go(dx < 0 ? 1 : -1);
        });
        showStep(p, 0);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --blue: #005cff;
    --blue-2: #008cff;
    --ink: #07172f;
    --muted: #38506d;
    --line: rgba(0, 92, 255, 0.14);
    --radius: 22px;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 84px;
  }
  body {
    margin: 0;
    font-family: Inter, system-ui, -apple-system, "Segoe UI", sans-serif;
    color: var(--ink);
    background:
      radial-gradient(circle at 12% 0%, rgba(53, 182, 255, 0.3), transparent 32%),
      radial-gradient(circle at 92% 8%, rgba(22, 104, 255, 0.2), transparent 30%),
      linear-gradient(180deg, #f5fbff, #eaf6ff 40%, #fff);
    overflow-x: hidden;
  }
  img {
    max-width: 100%;
  }
  h1,
  h2,
  h3,
  h4,
  p {
    margin: 0;
  }
  [hidden] {
    display: none !important;
  }
  :focus-visible {
    outline: 3px solid var(--blue-2);
    outline-offset: 3px;
    border-radius: 10px;
  }

  /* NAV */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 12px clamp(16px, 5vw, 64px);
    transition: background 0.25s, box-shadow 0.25s;
  }
  .nav--solid {
    background: rgba(245, 251, 255, 0.85);
    backdrop-filter: blur(14px);
    box-shadow: 0 6px 24px rgba(0, 60, 160, 0.08);
  }
  .nav__brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 900;
    font-size: 22px;
    color: var(--ink);
    text-decoration: none;
  }
  .nav__brand img {
    border-radius: 12px;
  }
  .nav__links {
    display: flex;
    gap: 22px;
    margin-left: auto;
  }
  .nav__links a {
    color: var(--muted);
    font-weight: 700;
    text-decoration: none;
  }
  .nav__links a:hover {
    color: var(--blue);
  }

  /* BOTONES */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 54px;
    padding: 0 26px;
    border-radius: 16px;
    background: linear-gradient(135deg, var(--blue-2), var(--blue));
    color: #fff;
    font-weight: 900;
    font-size: 17px;
    text-decoration: none;
    box-shadow: 0 16px 34px rgba(0, 102, 255, 0.3);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 22px 44px rgba(0, 102, 255, 0.4);
  }
  .btn--small {
    min-height: 42px;
    padding: 0 18px;
    font-size: 15px;
    border-radius: 12px;
  }

  /* BOTÓN GOOGLE PLAY (principal) */
  .play {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    padding: 16px 32px 16px 26px;
    border-radius: 20px;
    background: #0b1220;
    color: #fff;
    text-decoration: none;
    box-shadow: 0 22px 46px rgba(7, 23, 47, 0.35);
    transition: transform 0.2s, box-shadow 0.2s;
    animation: pulse 2.8s ease-in-out infinite;
  }
  .play:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 28px 56px rgba(7, 23, 47, 0.45);
    animation: none;
  }
  .play__logo {
    width: 44px;
    height: 44px;
    flex: none;
  }
  .play__text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    text-align: left;
  }
  .play__text small {
    font-size: 12px;
    letter-spacing: 0.12em;
    opacity: 0.8;
    font-weight: 700;
  }
  .play__text strong {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .play--light {
    background: #fff;
    color: var(--ink);
  }
  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 22px 46px rgba(7, 23, 47, 0.35), 0 0 0 0 rgba(0, 140, 255, 0.45);
    }
    50% {
      box-shadow: 0 22px 46px rgba(7, 23, 47, 0.35), 0 0 0 16px rgba(0, 140, 255, 0);
    }
  }

  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: clamp(20px, 4vw, 64px);
    padding: clamp(16px, 4vw, 48px) clamp(16px, 5vw, 80px) clamp(40px, 6vw, 80px);
    max-width: 1320px;
    margin-inline: auto;
  }
  .chip {
    display: inline-flex;
    padding: 9px 16px;
    border-radius: 999px;
    background: rgba(0, 119, 255, 0.12);
    color: #005fd1;
    font-weight: 800;
    font-size: 14px;
    margin-bottom: 20px;
  }
  h1 {
    font-size: clamp(40px, 6vw, 76px);
    line-height: 0.98;
    letter-spacing: -0.055em;
    margin-bottom: 22px;
  }
  .grad {
    background: linear-gradient(120deg, var(--blue-2), var(--blue) 60%, #6a3dff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lead {
    max-width: 540px;
    font-size: clamp(17px, 1.8vw, 22px);
    line-height: 1.5;
    color: var(--muted);
    margin-bottom: 32px;
  }
  .trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    list-style: none;
    padding: 0;
    margin: 26px 0 0;
    color: var(--muted);
    font-weight: 700;
    font-size: 15px;
  }
  .hero__visual {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .glow {
    position: absolute;
    inset: 10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 140, 255, 0.4), transparent 65%);
    filter: blur(40px);
  }
  .poster {
    position: relative;
    width: min(100%, 640px);
    height: auto;
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    50% {
      transform: translateY(-12px) rotate(0.6deg);
    }
  }

  /* SECCIONES */
  .section {
    padding: clamp(56px, 8vw, 110px) clamp(16px, 5vw, 80px);
  }
  .section--tint {
    background: linear-gradient(180deg, rgba(0, 140, 255, 0.07), rgba(0, 140, 255, 0.02));
  }
  .section__head {
    max-width: 720px;
    margin: 0 auto clamp(32px, 5vw, 56px);
    text-align: center;
  }
  .section__head .chip {
    margin-bottom: 14px;
  }
  h2 {
    font-size: clamp(30px, 4.4vw, 52px);
    line-height: 1.04;
    letter-spacing: -0.045em;
    margin-bottom: 14px;
  }
  .section__head p {
    color: var(--muted);
    font-size: clamp(16px, 1.7vw, 20px);
    line-height: 1.5;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
    max-width: 1180px;
    margin-inline: auto;
  }
  .card {
    padding: 28px;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--line);
    box-shadow: 0 10px 30px rgba(0, 70, 170, 0.07);
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }
  .card:hover {
    transform: translateY(-6px);
    border-color: rgba(0, 140, 255, 0.5);
    box-shadow: 0 22px 46px rgba(0, 70, 170, 0.16);
  }
  .card__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 18px;
    border-radius: 16px;
    background: linear-gradient(135deg, #e3f1ff, #cfe6ff);
    font-size: 28px;
    transition: transform 0.3s;
  }
  .card:hover .card__icon {
    transform: rotate(-8deg) scale(1.12);
  }
  .card h3 {
    font-size: 21px;
    margin-bottom: 8px;
    letter-spacing: -0.02em;
  }
  .card p {
    color: var(--muted);
    line-height: 1.5;
  }

  /* TUTORIALES */
  .tuto {
    max-width: 1100px;
    margin-inline: auto;
  }
  .tuto__tabs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 28px;
  }
  .tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    padding: 16px 18px;
    border-radius: 18px;
    border: 2px solid var(--line);
    background: #fff;
    color: var(--ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform 0.2s, border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }
  .tab:hover {
    transform: translateY(-3px);
    border-color: rgba(0, 140, 255, 0.5);
  }
  .tab[aria-selected="true"] {
    border-color: var(--blue);
    background: linear-gradient(135deg, #eaf4ff, #fff);
    box-shadow: 0 14px 30px rgba(0, 92, 255, 0.18);
  }
  .tab__icon {
    font-size: 26px;
  }
  .tab__name {
    font-weight: 900;
    font-size: 18px;
  }
  .tab__sub {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.3;
  }

  .panel {
    padding: clamp(18px, 3vw, 36px);
    border-radius: 28px;
